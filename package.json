{
  "name": "parashurama",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "PARASHURAMA \u2013 AI counter-drone decision trainer (SIH 2026, PS SIH26247, Team Dhwanik_TH06)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run dev -w @parashurama/web",
    "build": "npm run build -w @parashurama/web && npm run build -w @parashurama/server",
    "build:single": "npm run build:single -w @parashurama/web",
    "preview": "npm run preview -w @parashurama/web",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p apps/web --noEmit && tsc -p apps/server --noEmit",
    "validate:config": "tsx packages/engine/scripts/validate-config.ts",
    "e2e": "npm run e2e -w @parashurama/web",
    "loadtest": "tsx scripts/loadtest.ts",
    "fps": "node scripts/fps.mjs",
    "crewload": "tsx scripts/crewload.ts",
    "ci": "npm run typecheck && npm run check:generated && npm run validate:config && npm test && npm run build && npm run build:single",
    "server": "npm run start -w @parashurama/server",
    "server:dev": "npm run dev -w @parashurama/server",
    "make-cert": "bash deploy/make-cert.sh",
    "gen:validators": "tsx packages/engine/scripts/gen-validators.ts",
    "check:generated": "tsx packages/engine/scripts/gen-validators.ts --check",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > docs/sbom.cdx.json",
    "notices": "node scripts/notices.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:docs": "npm run build -w @parashurama/web && npm run build:single && node scripts/release-docs.mjs",
    "pack:keygen": "tsx packages/engine/scripts/pack-keygen.ts",
    "pack:sign": "tsx packages/engine/scripts/sign-pack.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
