{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gun detachment: guns, ammunition, targets and procedure (training values, not equipment specifications)",
  "type": "object",
  "required": ["version", "ammo", "guns", "targets", "manualSight", "procedure", "met"],
  "additionalProperties": false,
  "definitions": {
    "pos": { "type": "number", "exclusiveMinimum": 0 },
    "nn": { "type": "number", "minimum": 0 },
    "sizeMap": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
    "check": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }, "label": { "type": "string", "minLength": 1 } } }
  },
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string" },
    "ammo": { "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "object", "additionalProperties": false,
        "required": ["label", "massKg", "caliberM", "mv", "mvSd", "mvPerDegC", "tracerSec", "selfDestructSec", "sdFailP", "cdMach"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "massKg": { "$ref": "#/definitions/pos" }, "caliberM": { "$ref": "#/definitions/pos" },
          "mv": { "type": "number", "minimum": 100, "maximum": 2000 }, "mvSd": { "$ref": "#/definitions/nn" }, "mvPerDegC": { "$ref": "#/definitions/nn" },
          "tracerSec": { "$ref": "#/definitions/nn" }, "selfDestructSec": { "$ref": "#/definitions/nn" },
          "sdFailP": { "type": "number", "minimum": 0, "maximum": 1 },
          "cdMach": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } } } } } },
    "guns": { "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "object", "additionalProperties": false,
        "required": ["label", "short", "sight", "barrels", "rpmPerBarrel", "beltRounds", "ammo", "slewDegS", "elevDeg", "effRangeM", "dispMil", "heatPerRound", "coolPerSec", "heatLimit", "stoppageP", "sightFovDeg"],
        "properties": {
          "label": { "type": "string", "minLength": 1 }, "short": { "type": "string", "minLength": 1, "maxLength": 18 },
          "sight": { "enum": ["manual", "radar"] },
          "barrels": { "type": "integer", "minimum": 1, "maximum": 8 }, "rpmPerBarrel": { "type": "number", "minimum": 60, "maximum": 6000 },
          "beltRounds": { "type": "integer", "minimum": 1 }, "ammo": { "type": "string" },
          "slewDegS": { "type": "object", "required": ["az", "el"], "additionalProperties": false, "properties": { "az": { "$ref": "#/definitions/pos" }, "el": { "$ref": "#/definitions/pos" } } },
          "elevDeg": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -20, "maximum": 90 } },
          "effRangeM": { "$ref": "#/definitions/pos" }, "dispMil": { "$ref": "#/definitions/nn" },
          "heatPerRound": { "$ref": "#/definitions/nn" }, "coolPerSec": { "$ref": "#/definitions/nn" }, "heatLimit": { "$ref": "#/definitions/pos" },
          "stoppageP": { "type": "number", "minimum": 0, "maximum": 0.2 },
          "sightFovDeg": { "type": "number", "minimum": 2, "maximum": 60 },
          "reload": { "type": "array", "minItems": 1, "description": "Optional reload drill, in order (training values). Missing = one-step load taking procedure.loadSec.",
            "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "sec"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }, "label": { "type": "string", "minLength": 1 }, "sec": { "$ref": "#/definitions/nn" } } } },
          "radar": { "type": "object", "additionalProperties": false, "required": ["acquireRangeM", "lockSec", "trackNoiseMil", "faultP"],
            "properties": { "acquireRangeM": { "$ref": "#/definitions/pos" }, "lockSec": { "$ref": "#/definitions/nn" }, "trackNoiseMil": { "$ref": "#/definitions/nn" }, "faultP": { "type": "number", "minimum": 0, "maximum": 1 } } } } } },
    "targets": { "type": "object", "additionalProperties": false, "required": ["hitRadiusM", "hitsToKill"],
      "properties": { "hitRadiusM": { "$ref": "#/definitions/sizeMap" }, "hitsToKill": { "$ref": "#/definitions/sizeMap" },
        "engageRangeM": { "$ref": "#/definitions/sizeMap", "description": "Optional: best range to open fire by target size (small drones need short range to hit). Missing = the gun's effective range." } } },
    "manualSight": { "type": "object", "additionalProperties": false, "required": ["speedStepMs", "courseStepDeg", "rangeStepM"],
      "properties": { "speedStepMs": { "$ref": "#/definitions/pos" }, "courseStepDeg": { "$ref": "#/definitions/pos" }, "rangeStepM": { "$ref": "#/definitions/pos" } } },
    "procedure": { "type": "object", "additionalProperties": false,
      "required": ["ackSec", "loadSec", "layWithinSec", "firstBurstWithinSec", "burstMin", "burstMax", "safeWithinSec", "stoppageClearSec", "barrelChangeSec"],
      "properties": {
        "ackSec": { "$ref": "#/definitions/nn" }, "loadSec": { "$ref": "#/definitions/nn" }, "layWithinSec": { "$ref": "#/definitions/pos" },
        "firstBurstWithinSec": { "$ref": "#/definitions/pos" }, "burstMin": { "type": "integer", "minimum": 1 }, "burstMax": { "type": "integer", "minimum": 1 },
        "safeWithinSec": { "$ref": "#/definitions/pos" }, "stoppageClearSec": { "$ref": "#/definitions/nn" }, "barrelChangeSec": { "$ref": "#/definitions/nn" },
        "standToSec": { "type": "object", "additionalProperties": false, "required": ["white", "yellow", "red"], "properties": { "white": { "$ref": "#/definitions/nn" }, "yellow": { "$ref": "#/definitions/nn" }, "red": { "$ref": "#/definitions/nn" } } },
        "killReportSec": { "$ref": "#/definitions/pos" } } },
    "met": { "type": "object", "additionalProperties": false, "required": ["stdTempC", "stdPressureHpa", "latitudeDeg"],
      "properties": { "stdTempC": { "type": "number", "minimum": -50, "maximum": 60 }, "stdPressureHpa": { "type": "number", "minimum": 500, "maximum": 1100 }, "latitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 } } },
    "lfx": { "type": "object", "additionalProperties": false, "required": ["gunChecks", "rangeChecks", "checkSec", "uxoSearchSec"],
      "description": "Optional live-fire drill procedure. Missing = no pre-firing checks or range sweep (drills before v0.7).",
      "properties": {
        "note": { "type": "string" },
        "gunChecks": { "type": "array", "items": { "$ref": "#/definitions/check" } },
        "rangeChecks": { "type": "array", "items": { "$ref": "#/definitions/check" } },
        "checkSec": { "$ref": "#/definitions/nn" }, "uxoSearchSec": { "$ref": "#/definitions/nn" } } },
    "uav": { "type": "object", "additionalProperties": false, "description": "Optional UAV ground-control-station strike drill (training model).",
      "required": ["label", "speed", "altM", "turnDegS", "munition", "corridorHalfWidthM", "gimbalFovDeg", "gimbalSlewDegS", "clearanceSec", "takeoffSec", "landSec", "checks"],
      "properties": {
        "note": { "type": "string" }, "label": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 10, "maximum": 120 }, "altM": { "type": "number", "minimum": 50, "maximum": 3000 }, "turnDegS": { "$ref": "#/definitions/pos" },
        "munition": { "type": "object", "additionalProperties": false, "required": ["label", "massKg", "caliberM", "cdMach", "lethalRadiusM"],
          "properties": { "label": { "type": "string" }, "massKg": { "$ref": "#/definitions/pos" }, "caliberM": { "$ref": "#/definitions/pos" }, "lethalRadiusM": { "$ref": "#/definitions/pos" },
            "cdMach": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } } } } },
        "corridorHalfWidthM": { "$ref": "#/definitions/pos" }, "gimbalFovDeg": { "$ref": "#/definitions/pos" }, "gimbalSlewDegS": { "$ref": "#/definitions/pos" },
        "clearanceSec": { "$ref": "#/definitions/nn" }, "takeoffSec": { "$ref": "#/definitions/nn" }, "landSec": { "$ref": "#/definitions/nn" },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } } } },
    "orders": { "type": "object", "additionalProperties": false, "description": "Words of command shown and spoken in the drill. Optional; missing = built-in placeholders.",
      "required": ["rangeClear", "alert", "target", "method", "engage", "hold", "cease", "unload", "ack", "ready", "onTarget", "stoppage", "reportSafe"],
      "properties": { "note": { "type": "string" }, "rangeClear": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 }, "method": { "type": "string", "minLength": 1 }, "engage": { "type": "string", "minLength": 1 }, "hold": { "type": "string", "minLength": 1 }, "alert": { "type": "string", "minLength": 1 }, "cease": { "type": "string", "minLength": 1 }, "unload": { "type": "string", "minLength": 1 }, "ack": { "type": "string", "minLength": 1 }, "ready": { "type": "string", "minLength": 1 }, "onTarget": { "type": "string", "minLength": 1 }, "stoppage": { "type": "string", "minLength": 1 }, "reportSafe": { "type": "string", "minLength": 1 }, "killDestroyed": { "type": "string", "minLength": 1 }, "killNoEffect": { "type": "string", "minLength": 1 }, "rangeGreen": { "type": "string", "minLength": 1 } } }
  }
}
